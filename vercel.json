{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "cd web && npm install && npm run build",
  "outputDirectory": "web/dist",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/index" }
  ],
  "regions": ["iad1"],
  "functions": {
    "api/index.py": {
      "maxDuration": 30,
      "includeFiles": "{server,src}/**/*.py"
    }
  }
}
