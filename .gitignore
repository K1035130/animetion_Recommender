# 数据（大文件，不入库）
data/raw/
data/processed/
*.zip
*.jsonlines

# 中间产物默认不入库，但 tag 词表例外 —— 它不是纯派生数据，而是**人工审查过的
# 规则表产物**（418 个题材 tag 逐条看过），且是 jieba 自定义词典的运行时依赖。
# 入库后 clone 下来不必先跑 946 MB 扫描才能用。
#
# ⚠️ 写成 data/interim/* 而不是 data/interim/：被忽略的是**目录**时，
#    git 不会再进去看，后面的 ! 取反规则会失效。
data/interim/*
!data/interim/tag_vocab.json
# staff_vec 的维度定义，与 tag_vocab.json 同一条理由：它不是纯派生数据，
# 而是「库里每个向量的每一维代表谁」的唯一记录。
# ⚠️ 不入 git 的文件一旦参与打分链路就是定时炸弹 —— 开发机上永远正常，
#    只在别人的机器上静默地错（recommend.py 的 series_root.json 就是前车之鉴）。
!data/interim/staff_vocab.json

# Python
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.ruff_cache/

# 环境变量（含 Neon 连接串）
.env
.env.*
!.env.example

# 编辑器 / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# 前端
web/node_modules/
web/dist/
.vercel/
