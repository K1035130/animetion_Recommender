# 复制为 .env 并填入真实值。.env 已在 .gitignore 中排除。

# Neon Postgres
# 直连：建表 / 批量灌数据用
DATABASE_URL_DIRECT=postgresql://USER:PASSWORD@ep-xxx.REGION.aws.neon.tech/neondb?sslmode=require
# 连接池：线上 FastAPI 用（主机名多一段 -pooler）
# 本地不配也能跑 —— db.pool_dsn() 会退回 DATABASE_URL_DIRECT。
# ⚠️ 但线上必须配：serverless 每个函数实例各开一个池，直连会耗尽 Neon 的连接数。
DATABASE_URL=postgresql://USER:PASSWORD@ep-xxx-pooler.REGION.aws.neon.tech/neondb?sslmode=require

# CORS 白名单，逗号分隔。**只在本地开发有用**，不配则默认放行 Vite 的 5173。
#
# ⚠️ **线上不要配这个变量。** 前端与 API 同属一个 Vercel 项目、共用一个域名
#    （vercel.json 把 /api/* 转给函数、其余交给 web/dist），线上是同源的，
#    CORS 中间件根本不参与。配了只会让人以为跨域还在生效。
#    若线上真出了跨域报错，说明前端把请求打到了别的域名上 ——
#    该查的是 web/src/api.ts 的 BASE（应当恒为相对路径 '/api'），不是这里。
CORS_ORIGINS=

# 硅基流动 API（第 3 周线上 query embedding 用）
SILICONFLOW_API_KEY=
